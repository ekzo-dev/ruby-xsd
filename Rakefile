# frozen_string_literal: true

require 'bundler/gem_tasks'
require 'rspec/core/rake_task'

desc 'Run all specs'
RSpec::Core::RakeTask.new(:spec)  do |t|
  t.pattern = 'spec/**/*_spec.rb'
  t.verbose = false
end

require 'rubocop/rake_task'

RuboCop::RakeTask.new do |t|
  t.options = ['--display-cop-names']
end

namespace :rbs do
  desc 'Generate sig/xsd_members.rbs: the readers BaseObject.property, .child and .link define for each class'
  task :members do
    $LOAD_PATH.unshift File.expand_path('lib', __dir__)
    require 'xsd'

    scalars = { string: 'String', boolean: 'bool', integer: 'Integer', array: 'Array[untyped]' }
    class_of = ->(type) { XSD::XML::CLASS_MAP[type.to_s]&.name&.delete_prefix('XSD::') || 'BaseObject' }
    lines = []
    XSD.constants.map { |name| XSD.const_get(name) }.select { |k| k.is_a?(Class) && k <= XSD::BaseObject }
       .sort_by(&:name).each do |klass|
      superclass = klass.superclass
      own = lambda do |kind|
        members = klass.public_send(kind)
        superclass.respond_to?(kind) ? members.reject { |name, spec| superclass.public_send(kind)[name] == spec } : members
      end
      # a method the class or an ancestor defines itself wins over the reader, and is declared in xsd.rbs
      explicit = lambda do |name|
        klass.method_defined?(name) && klass.instance_method(name).owner.name && klass.instance_method(name).owner != Object
      end
      readers = {}
      own.call(:properties).each do |name, spec|
        type = scalars.fetch(spec[:type], 'untyped')
        type = "#{type}?" unless spec[:required] || spec.key?(:default) || type.start_with?('Array')
        type = '(Integer | :unbounded)' if name == :max_occurs
        readers[name] ||= type unless explicit.call(name)
      end
      [*own.call(:children), *own.call(:links)].each do |name, spec|
        type = spec[:type]
        readers[name] ||= (type.is_a?(Array) ? "Array[#{class_of.call(type.first)}]" : "#{class_of.call(type)}?") unless explicit.call(name)
      end
      next if readers.empty?

      lines << "  class #{klass.name.delete_prefix('XSD::')}"
      readers.each { |name, type| lines << "    def #{name}: () -> #{type}" }
      lines << '  end' << ''
    end
    File.write(File.expand_path('sig/xsd_members.rbs', __dir__), <<~RBS)
      # Generated by `rake rbs:members` — do not edit. The readers BaseObject's `property`, `child` and `link`
      # define for each class: a property is its value (nil when absent and without a default), a child or a link
      # the object or objects it names.
      module XSD
      #{lines.join("\n").rstrip}
      end
    RBS
  end
end

desc 'Run tests'
task test: :spec

desc 'Run linter'
task lint: :rubocop

desc 'Run linter and tests'
task default: %i[lint spec]
